#!/usr/bin/env bash
# Install or update the hourly collector as systemd user units. Idempotent: re-run after a commit
# to deploy it. Data lives in ~/.local/share/hourly-changefeed; builds in ~/.local/state/changefeed.
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
state="$HOME/.local/state/changefeed"
data="$HOME/.local/share/hourly-changefeed"
sock="$data/pgdata/sock"
mkdir -p "$state" "$data" "$HOME/.config/systemd/user"

nix build "$repo#default" --out-link "$state/result"
nix build "$repo#postgres" --out-link "$state/postgres"
PATH="$state/postgres/bin:$PATH" PGDATA="$data/pgdata" "$repo/scripts/pg-init"

install -m 0644 "$repo"/deploy/systemd/changefeed*.{service,timer} "$HOME/.config/systemd/user/"
systemctl --user daemon-reload
systemctl --user enable --now changefeed-postgres.service

if ! "$state/postgres/bin/psql" -h "$sock" -d postgres -tAc "SELECT 1 FROM pg_database WHERE datname = 'changefeed'" | grep -q 1; then
  "$state/postgres/bin/createdb" -h "$sock" changefeed
fi
export CHANGEFEED_DB="host=$sock dbname=changefeed"
"$state/result/bin/changefeed" migrate
"$state/result/bin/changefeed" seed load "$repo/registry/boards.tsv"
systemctl --user enable --now changefeed.timer changefeed-daily.timer

if ! loginctl show-user "$USER" -p Linger | grep -q '=yes'; then
  echo "install-collector: Linger is off, so the timer only runs while you are logged in." >&2
  echo "install-collector: run 'loginctl enable-linger' to keep it running after logout." >&2
fi
systemctl --user list-timers 'changefeed*' --no-pager
